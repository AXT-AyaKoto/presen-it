{
    "name": "@axt_ayakoto/presenit",
    "version": "0.7.7",
    "description": "Turn readable Markdown into beautiful presentation slides and PDFs.",
    "keywords": [
        "markdown",
        "marp",
        "pdf",
        "presenit",
        "presentation",
        "slides",
        "slidev"
    ],
    "homepage": "https://github.com/AXT-AyaKoto/presen-it#readme",
    "bugs": {
        "url": "https://github.com/AXT-AyaKoto/presen-it/issues"
    },
    "license": "MIT",
    "author": "Ayasaka-Koto (@AXT_AyaKoto)",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/AXT-AyaKoto/presen-it.git"
    },
    "bin": {
        "presenit": "./dist/cli.js"
    },
    "files": [
        "dist/cli.js",
        "dist/cli.js.map",
        "dist/index.js",
        "dist/index.js.map",
        "dist/index.d.ts",
        "src/viewer",
        "src/shared",
        "llms.txt",
        "LICENSE",
        "README.md",
        "CHANGELOG.md"
    ],
    "type": "module",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./package.json": "./package.json"
    },
    "publishConfig": {
        "access": "public",
        "registry": "https://registry.npmjs.org/"
    },
    "scripts": {
        "build": "tsup",
        "dev:cli": "tsx src/cli.ts",
        "presenit": "node ./dist/cli.js",
        "prepublishOnly": "pnpm check && pnpm build",
        "format": "oxfmt .",
        "format:check": "oxfmt --check .",
        "lint": "oxlint .",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "test:watch": "vitest",
        "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test"
    },
    "dependencies": {
        "@preact/preset-vite": "^2.10.6",
        "@preact/signals": "^2.10.0",
        "beautiful-mermaid": "^1.1.3",
        "citty": "^0.2.2",
        "consola": "^3.4.2",
        "hast-util-to-html": "^9.0.5",
        "katex": "0.18.1",
        "mdast-util-to-hast": "^13.2.1",
        "mdast-util-to-string": "^4.0.0",
        "preact": "^10.29.7",
        "puppeteer": "^25.4.0",
        "rehype-stringify": "^10.0.1",
        "remark-breaks": "^4.0.0",
        "remark-gfm": "^4.0.1",
        "remark-math": "^6.0.0",
        "remark-parse": "^11.0.0",
        "remark-rehype": "^11.1.2",
        "shiki": "^4.3.1",
        "unified": "^11.0.5",
        "unist-util-visit": "^5.1.0",
        "vite": "^8.1.5",
        "yaml": "^2.9.0"
    },
    "devDependencies": {
        "@types/hast": "^3.0.5",
        "@types/katex": "^0.16.8",
        "@types/mdast": "^4.0.4",
        "@types/node": "^24.0.0",
        "@types/unist": "^3.0.3",
        "oxfmt": "^0.61.0",
        "oxlint": "^1.0.0",
        "tsup": "^8.5.0",
        "tsx": "^4.20.0",
        "typescript": "^5.8.0",
        "vitest": "^3.2.0"
    },
    "engines": {
        "node": ">=22"
    },
    "packageManager": "pnpm@11.11.0"
}
